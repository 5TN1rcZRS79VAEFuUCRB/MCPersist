# Secrets and personal config - never commit these
config.json
relay/users.json
relay/auto_assignments.json
# Runtime status snapshot (no secrets - subdomains/IPs/counts only, but still
# per-deployment runtime state, not something to track)
relay/relay_status.json
# The atomic write-then-rename pattern used by all three of the above leaves a
# same-named *.tmp file holding the exact same secrets until the rename completes -
# covered here too, not just the final filenames.
*.json.tmp

# Runtime data - world saves, downloaded server jars, logs
servers/
bin/
gui.pid
assigned_address.txt

# Python
__pycache__/
*.pyc

# PyInstaller build output
dist/
build/
*.spec
